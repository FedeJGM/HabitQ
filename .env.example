# Shared configuration for backend/ (python-dotenv / pydantic-settings) and
# mobile/ (passed via `flutter run --dart-define-from-file=../.env`).
#
# Copy this file to `.env` in the repo root and fill in real values.
# `.env` is gitignored -- never commit it.

# --- Backend (FastAPI) ---
# Postgres connection string. Database must exist already (see README setup steps).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/habitq

# Secret used to sign HabitQ's own JWTs. Use a long random string in real environments.
JWT_SECRET=change-me-to-a-long-random-string

# --- Shared (backend validates, mobile requests) ---
# OAuth 2.0 Web Client ID from Google Cloud Console (used as the JWT audience
# when the backend verifies the Google ID token). See README for how to obtain it.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# --- Mobile (Flutter) ---
# Base URL the app uses to reach the backend.
API_BASE_URL=http://10.0.2.2:8000

# --- Gemini ---
GEMINI_API_KEY=
