# Flutter regenerates these plugin registrants with LF line endings on every
# build. Without this rule, Git on Windows (core.autocrlf=true) lists them as
# modified although their content did not change.
mobile/linux/flutter/generated_plugin_registrant.cc text eol=lf
mobile/linux/flutter/generated_plugin_registrant.h text eol=lf
mobile/linux/flutter/generated_plugins.cmake text eol=lf
mobile/macos/Flutter/GeneratedPluginRegistrant.swift text eol=lf
mobile/windows/flutter/generated_plugin_registrant.cc text eol=lf
mobile/windows/flutter/generated_plugin_registrant.h text eol=lf
mobile/windows/flutter/generated_plugins.cmake text eol=lf
